# 1) Ensure you are on main and up to date
git checkout main
git pull origin main

# 2) Install deps cleanly
rm -rf node_modules .next
npm ci

# 3) Export production Tina env (use your real values)
export TINA_PUBLIC_IS_LOCAL=false
export NODE_ENV=production
export NEXT_PUBLIC_TINA_CLIENT_ID="your_tina_client_id"
export TINA_TOKEN="your_tina_token"
# optional but recommended if you use a non-main content branch:
# export NEXT_PUBLIC_TINA_BRANCH="main"

# 4) Clean local compilation of the cloud admin bundle
npx tinacms build --skip-cloud-checks

# 5) Sanity check: admin must NOT point at localhost Tina
# (should print nothing)
grep -R "localhost:4001" public/admin || true

# 6) Commit generated admin outputs + any schema-generated files Tina updated
git add public/admin tina/__generated__
git status
git commit -m "Rebuild Tina admin bundle for production schema sync"

# 7) Push the same commit hash to main (Vercel + TinaCloud webhook)
git push origin main
